# 1Password secret references for the Pokemon Trade Advisor.
#
# This file contains op:// URIs — NOT actual secrets — so it is safe to
# commit to version control. Secrets are resolved at command-execution time
# by the 1Password CLI.
#
# Usage:
#   op run --env-file .env.op -- uv run python app.py
#   op run --env-file .env.op -- uv run pytest tests/ -v --tb=short
#
# One-time setup: make sure 1Password CLI is installed and you are signed in:
#   brew install --cask 1password/tap/1password-cli
#   eval $(op signin)

# --- LLM API keys ---
# Only include entries for keys you have stored in 1Password.
# op run will error on any op:// reference it cannot resolve.
ANTHROPIC_API_KEY=op://Private/ANTHROPIC_API_KEY/credential
# GOOGLE_API_KEY=op://Private/GOOGLE_API_KEY/credential
# OPENAI_API_KEY=op://Private/OPENAI_API_KEY/credential
# Ollama Cloud API key (only for direct access — see OLLAMA_URL above)
# Get one from: https://ollama.com/settings/keys
# OLLAMA_API_KEY=op://Private/OLLAMA_API_KEY/credential

# --- Web API (make run-api) ---
TENANT_DB_ENCRYPTION_KEY=op://Private/TENANT_DB_ENCRYPTION_KEY/credential
# Sentry DSN — from your Sentry project's Settings > Client Keys (DSN)
SENTRY_DSN=op://Private/SENTRY_DSN/credential
# Rate-limit counter storage — e.g. an Upstash Redis rediss:// URL
# RATE_LIMIT_STORAGE_URI=op://Private/RATE_LIMIT_STORAGE_URI/credential

# --- Chroma Cloud (ROADMAP.md Phase 9) ---
# All from your Chroma Cloud project's own quickstart page (trychroma.com)
# CHROMA_API_KEY=op://Private/CHROMA_API_KEY/credential
# CHROMA_TENANT=op://Private/CHROMA_TENANT/credential
# CHROMA_DATABASE=op://Private/CHROMA_DATABASE/credential
# Only needed for a non-default/dedicated Chroma deployment
# CHROMA_HOST=op://Private/CHROMA_HOST/credential
