# Pokemon Trainer AI — Environment Variables
#
# Copy this file to .env and fill in your values — config.py loads it
# automatically (via python-dotenv), no sourcing needed. A .env.local file
# works the same way and takes precedence over .env, for per-machine
# overrides you'd rather keep separate. Either way, a real environment
# variable (shell export, Docker, op run, CI) always wins over both files.
#
# Or use .env.op (1Password references) if you have the 1Password CLI set
# up. See docs/1PASSWORD.md for the 1Password approach.
#
# Variables with defaults are optional — the app runs with the defaults shown.

# -- LLM API Keys (at least one required) ------------------------------------

# Anthropic Claude (default provider)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini (needed for: make run-gemini)
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI GPT-4o (needed for: make run-openai)
# OPENAI_API_KEY=your-openai-api-key-here

# -- Model Selection ---------------------------------------------------------

# Active model. Options: claude-sonnet, claude-haiku, gemini-flash, gemini-pro,
# gpt-4o, gpt-4o-mini, llama, llama-cloud
# Default: claude-sonnet
# POKEMON_MODEL=claude-sonnet

# -- Infrastructure URLs (defaults work for local Docker/Colima) -------------

# ChromaDB vector database (start with: make chromadb-start)
# Default: http://localhost:8000
# CHROMADB_URL=http://localhost:8000

# Arize Phoenix observability UI (start with: make phoenix-start)
# Default: http://127.0.0.1:6006
# PHOENIX_URL=http://127.0.0.1:6006

# Ollama server URL (needed for: make run-ollama, run-ollama-cloud[-direct])
# Default: http://localhost:11434 — set to https://ollama.com for direct
# Ollama Cloud API access (needs OLLAMA_API_KEY below; no local ollama install)
# OLLAMA_URL=http://localhost:11434

# Ollama Cloud API key (only for direct access — see OLLAMA_URL above)
# Get one from: https://ollama.com/settings/keys
# OLLAMA_API_KEY=

# -- Embeddings --------------------------------------------------------------

# Use Ollama for embeddings instead of the default simple embedder
# Default: false
# USE_OLLAMA_EMBEDDINGS=false

# Ollama embedding model (used when USE_OLLAMA_EMBEDDINGS=true)
# Default: nomic-embed-text
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -- Observability -----------------------------------------------------------

# Phoenix project namespace shown in the tracing UI
# Default: pokemon-trade-advisor
# PROJECT_NAME=pokemon-trade-advisor

# -- Data Sources ------------------------------------------------------------

# Smogon competitive data base URL (used during make ingest)
# Default: https://pkmn.github.io/smogon/data
# SMOGON_URL=https://pkmn.github.io/smogon/data

# -- Platform Database (Optional) --------------------------------------------

# PostgreSQL connection string for the sister "Pokemon Trainer Platform" web
# API database. When set, the AI project reads live trade history, user
# collections, and incoming trade offers from PostgreSQL instead of the
# bundled mock JSON/SQLite data.
#
# Requires psycopg driver:  uv sync --group platform-db
# Schema contract:          docs/REFERENCE/PLATFORM_DB.md
#
# Format: postgresql://user:password@host:port/dbname
# When unset, all data sources fall back to mock data (zero breaking change).
# PLATFORM_DB_URL=postgresql://user:password@localhost:5432/pokemon_platform

# -- Web API (make run-api) --------------------------------------------------

# Host/port uvicorn binds to. Defaults shown are for a container/production
# run (0.0.0.0) — override for local-only testing if you don't want it
# reachable from other machines on your network.
# Default: 0.0.0.0
# API_HOST=0.0.0.0
# Default: 8080
# API_PORT=8080

# Required for any tenant operation (scripts/provision_tenant.py, and every
# authenticated API request) — encrypts each tenant's own platform_db_url at
# rest in data/tenants.db. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Back this up outside the deployment itself — losing it makes every stored
# platform_db_url permanently unrecoverable, not just hard to find.
# TENANT_DB_ENCRYPTION_KEY=

# Opt the API into the same Phoenix/OTEL tracing pipeline the CLI uses —
# only if Phoenix is already reachable; never auto-starts it via Docker from
# an unattended server process.
# Default: false
# ENABLE_PHOENIX=false

# Sentry DSN for dedicated error tracking (free "Developer" tier: 5,000
# errors/month). Unset = sentry_sdk runs as a documented no-op.
# SENTRY_DSN=

# redis:// or rediss:// URI for rate-limit counters (e.g. an Upstash Redis
# instance — it gives you a rediss:// TLS URL directly). Unset = an
# in-memory counter, correct for local dev but per-process — see
# ROADMAP.md Phase 9 for why that's not enough once there's more than one
# API instance running, or even across a single instance's own redeploys.
# RATE_LIMIT_STORAGE_URI=

# Chroma Cloud (ROADMAP.md Phase 9) — managed vector storage, replacing self-hosted
# ChromaDB in production. CHROMA_API_KEY's presence is the switch (rag/vector_store.py):
# set, the RAG layer talks to Chroma Cloud; unset (the default), local self-hosted ChromaDB
# via CHROMADB_URL above, same as before this phase. Get these from your Chroma Cloud
# project's own quickstart page (trychroma.com).
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=
# Optional — only needed for a non-default/dedicated Chroma deployment; the standard Chroma
# Cloud SaaS endpoint (api.trychroma.com) is CloudClient's own default when this is unset.
# CHROMA_HOST=

# -- Admin web UI (make run-admin, ROADMAP.md Phase 16) ----------------------

# Gates the admin UI's login page — a separate secret from any tenant's API
# key and from TENANT_DB_ENCRYPTION_KEY. Required for admin_server.py to
# start meaningfully. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=

# Host/port uvicorn binds to. Defaults to loopback-only, unlike the public
# API's API_HOST (0.0.0.0) — this surface is never meant to be reachable
# from another machine directly.
# Default: 127.0.0.1
# ADMIN_HOST=127.0.0.1
# Default: 8090
# ADMIN_PORT=8090

# -- Managed Postgres + envelope encryption (ROADMAP_PLATFORM.md Phase 17) --

# Admin/service connection string for one Aiven PostgreSQL service —
# api.managed_db provisions a dedicated database + role per tenant on it
# (CREATE DATABASE/CREATE ROLE), never handing out these credentials
# themselves. Only needed if POST /v1/accounts/register is ever called with
# use_managed_db=true (the default).
# AIVEN_ADMIN_DB_URL=postgresql://avnadmin:password@host:port/defaultdb?sslmode=require

# HashiCorp Vault (Transit secrets engine) — wraps a fresh per-tenant Data
# Encryption Key for every new tenant's platform_db_url, replacing the
# single static TENANT_DB_ENCRYPTION_KEY above. Required for any tenant
# creation (self-hosted or managed) going forward; an existing tenant row
# keeps working unmigrated until scripts/migrate_to_vault_encryption.py runs.
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=
# Default: tenant-db-encryption
# VAULT_TRANSIT_KEY_NAME=tenant-db-encryption

# Placeholder disclosure link until Phase 20 builds the real Terms/Privacy
# page — self-serve registration with use_managed_db=true requires
# terms_accepted=true, and this is what that points at in the meantime.
# Default: https://example.com/terms
# TERMS_URL=
