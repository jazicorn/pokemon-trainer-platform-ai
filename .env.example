# Pokemon Trainer AI — Environment Variables
#
# Copy this file to .env and fill in your values, or use .env.op
# (1Password references) if you have the 1Password CLI set up.
# See docs/1PASSWORD.md for the 1Password approach.
#
# Variables with defaults are optional — the app runs with the defaults shown.

# -- LLM API Keys (at least one required) ------------------------------------

# Anthropic Claude (default provider)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini (needed for: make run-gemini)
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI GPT-4o (needed for: make run-openai)
# OPENAI_API_KEY=your-openai-api-key-here

# -- Model Selection ---------------------------------------------------------

# Active model. Options: claude-sonnet, claude-haiku, gemini-flash, gemini-pro,
# gpt-4o, gpt-4o-mini, llama
# Default: claude-sonnet
# POKEMON_MODEL=claude-sonnet

# -- Infrastructure URLs (defaults work for local Docker/Colima) -------------

# ChromaDB vector database (start with: make chromadb-start)
# Default: http://localhost:8000
# CHROMADB_URL=http://localhost:8000

# Arize Phoenix observability UI (start with: make phoenix-start)
# Default: http://127.0.0.1:6006
# PHOENIX_URL=http://127.0.0.1:6006

# Ollama local inference server (needed for: make run-ollama)
# Default: http://localhost:11434
# OLLAMA_URL=http://localhost:11434

# -- Embeddings --------------------------------------------------------------

# Use Ollama for embeddings instead of the default simple embedder
# Default: false
# USE_OLLAMA_EMBEDDINGS=false

# Ollama embedding model (used when USE_OLLAMA_EMBEDDINGS=true)
# Default: nomic-embed-text
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -- Observability -----------------------------------------------------------

# Phoenix project namespace shown in the tracing UI
# Default: pokemon-trade-advisor
# PROJECT_NAME=pokemon-trade-advisor

# -- Data Sources ------------------------------------------------------------

# Smogon competitive data base URL (used during make ingest)
# Default: https://pkmn.github.io/smogon/data
# SMOGON_URL=https://pkmn.github.io/smogon/data
