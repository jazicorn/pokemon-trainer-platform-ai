# Pokemon Trainer AI — Environment Variables
#
# Copy this file to .env and fill in your values — config.py loads it
# automatically (via python-dotenv), no sourcing needed. A .env.local file
# works the same way and takes precedence over .env, for per-machine
# overrides you'd rather keep separate. Either way, a real environment
# variable (shell export, Docker, op run, CI) always wins over both files.
#
# Or use .env.op (1Password references) if you have the 1Password CLI set
# up. See docs/1PASSWORD.md for the 1Password approach.
#
# Variables with defaults are optional — the app runs with the defaults shown.

# -- LLM API Keys (at least one required) ------------------------------------

# Anthropic Claude (default provider)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini (needed for: make run-gemini)
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI GPT-4o (needed for: make run-openai)
# OPENAI_API_KEY=your-openai-api-key-here

# -- Model Selection ---------------------------------------------------------

# Active model. Options: claude-sonnet, claude-haiku, gemini-flash, gemini-pro,
# gpt-4o, gpt-4o-mini, llama, llama-cloud
# Default: claude-sonnet
# POKEMON_MODEL=claude-sonnet

# -- Infrastructure URLs (defaults work for local Docker/Colima) -------------

# ChromaDB vector database (start with: make chromadb-start)
# Default: http://localhost:8000
# CHROMADB_URL=http://localhost:8000

# Arize Phoenix observability UI (start with: make phoenix-start)
# Default: http://127.0.0.1:6006
# PHOENIX_URL=http://127.0.0.1:6006

# Ollama server URL (needed for: make run-ollama, run-ollama-cloud[-direct])
# Default: http://localhost:11434 — set to https://ollama.com for direct
# Ollama Cloud API access (needs OLLAMA_API_KEY below; no local ollama install)
# OLLAMA_URL=http://localhost:11434

# Ollama Cloud API key (only for direct access — see OLLAMA_URL above)
# Get one from: https://ollama.com/settings/keys
# OLLAMA_API_KEY=

# -- Embeddings --------------------------------------------------------------

# Use Ollama for embeddings instead of the default simple embedder
# Default: false
# USE_OLLAMA_EMBEDDINGS=false

# Ollama embedding model (used when USE_OLLAMA_EMBEDDINGS=true)
# Default: nomic-embed-text
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -- Observability -----------------------------------------------------------

# Phoenix project namespace shown in the tracing UI
# Default: pokemon-trade-advisor
# PROJECT_NAME=pokemon-trade-advisor

# -- Data Sources ------------------------------------------------------------

# Smogon competitive data base URL (used during make ingest)
# Default: https://pkmn.github.io/smogon/data
# SMOGON_URL=https://pkmn.github.io/smogon/data

# -- Platform Database (Optional) --------------------------------------------

# PostgreSQL connection string for the sister "Pokemon Trainer Platform" web
# API database. When set, the AI project reads live trade history, user
# collections, and incoming trade offers from PostgreSQL instead of the
# bundled mock JSON/SQLite data.
#
# Requires psycopg driver:  uv sync --group platform-db
# Schema contract:          docs/REFERENCE/PLATFORM_DB.md
#
# Format: postgresql://user:password@host:port/dbname
# When unset, all data sources fall back to mock data (zero breaking change).
# PLATFORM_DB_URL=postgresql://user:password@localhost:5432/pokemon_platform

# -- Web API (make run-api) --------------------------------------------------

# Host/port uvicorn binds to. Defaults shown are for a container/production
# run (0.0.0.0) — override for local-only testing if you don't want it
# reachable from other machines on your network.
# Default: 0.0.0.0
# API_HOST=0.0.0.0
# Default: 8080
# API_PORT=8080

# Required for any tenant operation (scripts/provision_tenant.py, and every
# authenticated API request) — encrypts each tenant's own platform_db_url at
# rest in data/tenants.db. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Back this up outside the deployment itself — losing it makes every stored
# platform_db_url permanently unrecoverable, not just hard to find.
# TENANT_DB_ENCRYPTION_KEY=

# Opt the API into the same Phoenix/OTEL tracing pipeline the CLI uses —
# only if Phoenix is already reachable; never auto-starts it via Docker from
# an unattended server process.
# Default: false
# ENABLE_PHOENIX=false

# Sentry DSN for dedicated error tracking (free "Developer" tier: 5,000
# errors/month). Unset = sentry_sdk runs as a documented no-op.
# SENTRY_DSN=
